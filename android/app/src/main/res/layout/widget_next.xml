<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_small"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/hat_small" />

    <TextView
        android:id="@+id/wn_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Vakit"
        android:textColor="#C7A24B"
        android:textSize="10sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/wn_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#F7F2E7"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wn_fallback"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text=""
        android:textColor="#F7F2E7"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
